# PostgreSQL (Unidad 1)
PG_PORT=40080
POSTGRES_USER=tu_usuario_pg
POSTGRES_PASSWORD=cambia_clave_pg
POSTGRES_DB=nombre_bd_pg

# MySQL
MYSQL_PORT=40081
MYSQL_ROOT_PASSWORD=cambia_clave_root_mysql
MYSQL_DATABASE=nombre_bd_mysql
MYSQL_USER=tu_usuario_mysql
MYSQL_PASSWORD=cambia_clave_mysql

# pgAdmin Web (Unidad 1)
PGADMIN_PORT=40082
PGADMIN_DEFAULT_EMAIL=admin@ejemplo.com
PGADMIN_DEFAULT_PASSWORD=cambia_clave_pgadmin

# MongoDB
MONGO_PORT=40085
MONGO_INITDB_ROOT_USERNAME=tu_usuario_root_mongo
MONGO_INITDB_ROOT_PASSWORD=cambia_clave_mongo
MONGO_INITDB_DATABASE=ecommerce_nosql

# Mongo Express
MONGO_EXPRESS_PORT=40086
ME_CONFIG_BASICAUTH_USERNAME=admin_express
ME_CONFIG_BASICAUTH_PASSWORD=cambia_clave_express
ME_CONFIG_MONGODB_ADMINUSERNAME=tu_usuario_root_mongo
ME_CONFIG_MONGODB_ADMINPASSWORD=cambia_clave_mongo
ME_CONFIG_MONGODB_SERVER=mongodb

# GraphQL API
GRAPHQL_PORT=4000
MONGO_URI=mongodb://tu_usuario_root_mongo:cambia_clave_mongo@mongodb:27017/ecommerce_nosql?authSource=admin