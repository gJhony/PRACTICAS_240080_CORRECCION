# ==============================================================================
# UTXJ - Unidad 2: Bases de Datos NoSQL en la Nube
# PLANTILLA DE VARIABLES DE ENTORNO - SOLO VALORES DE EJEMPLO / PLACEHOLDERS
# ==============================================================================
# Copiar en el VPS como .env  ->  cp .env.example .env
# Despues reemplazar TODOS los valores "CAMBIAR_*" por credenciales reales.
# .env esta ignorado por Git (Indicador 56). NUNCA subir credenciales reales.
# IP publica del VPS: 5.183.9.45
# ==============================================================================

# --- PostgreSQL (servicio postgres_jhon, contenedor postgres_jhon) -----------
PG_PORT=40080
POSTGRES_USER=jhony40080
POSTGRES_PASSWORD=CAMBIAR_CLAVE_POSTGRES
POSTGRES_DB=db_40080

# --- MySQL (servicio mysql_jhon, contenedor mysql_jhon) ----------------------
MYSQL_PORT=40081
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_MYSQL
MYSQL_DATABASE=db_test_7b
MYSQL_USER=jhon_jojos
MYSQL_PASSWORD=CAMBIAR_CLAVE_MYSQL

# --- pgAdmin Web (servicio pgadmin_jhon, contenedor pgadmin_jhon) -------------
PGADMIN_PORT=40082
PGADMIN_DEFAULT_EMAIL=CAMBIAR_CORREO_PGADMIN@ejemplo.com
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_CLAVE_PGADMIN

# --- MongoDB (servicio mongodb_jhon, contenedor mongodb_bitwatt) -------------
MONGO_PORT=40085
MONGO_INITDB_ROOT_USERNAME=CAMBIAR_USUARIO_ROOT_MONGO
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_MONGO
MONGO_INITDB_DATABASE=ecommerce_nosql
# Host:PUERTO que usa 06_tests_crud.js para abrir conexiones NUEVAS por rol y
# verificar denegaciones reales. Dentro del contenedor: 127.0.0.1:27017.
# Si ejecutas el script desde el VPS host: 127.0.0.1:40085.
MONGO_HOST=127.0.0.1:27017

# --- Mongo Express (servicio mongo_express_jhon) -----------------------------
MONGO_EXPRESS_PORT=40086
ME_CONFIG_BASICAUTH_USERNAME=CAMBIAR_USUARIO_EXPRESS
ME_CONFIG_BASICAUTH_PASSWORD=CAMBIAR_CLAVE_EXPRESS
# El hostname interno es el nombre del CONTENEDOR, no "mongodb".
ME_CONFIG_MONGODB_SERVER=mongodb_bitwatt
ME_CONFIG_MONGODB_PORT=27017

# --- API GraphQL (servicio graphql_jhon, contenedor graphql_jhon) ------------
GRAPHQL_PORT=40087
# MONGO_URI se construye automaticamente en docker-compose.yml.

# --- Usuarios de la BD ecommerce_nosql (scripts ./mongodb/01_users_roles.js) --
# Uno por cada rol e-commerce. Usa contrasenas distintas y largas en produccion.
MONGO_USR_SUPERADMIN_PASSWORD=CAMBIAR_CLAVE_SUPERADMIN
MONGO_USR_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN
MONGO_USR_SELLER_PASSWORD=CAMBIAR_CLAVE_SELLER
MONGO_USR_BUYER_PASSWORD=CAMBIAR_CLAVE_BUYER
MONGO_USR_SUPPORT_PASSWORD=CAMBIAR_CLAVE_SUPPORT
MONGO_USR_COMMON_PASSWORD=CAMBIAR_CLAVE_COMMON
MONGO_USR_NOT_REGISTERED_PASSWORD=CAMBIAR_CLAVE_NOT_REGISTERED
